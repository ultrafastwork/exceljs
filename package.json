{
  "name": "exceljs",
  "version": "4.5.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ultrafastwork/exceljs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.0",
  "main": "./excel.js",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "test": "npm run test:full",
    "test:es5": "export EXCEL_BUILD=es5 && npm run test:full",
    "test:full": "npm run build && npm run test:unit && npm run test:integration && npm run test:end-to-end && npm run test:jasmine && npm run test:typescript",
    "test:version": "npm run build && npm run test:unit && npm run test:integration && npm run test:end-to-end && npm run test:browser && npm run test:dist",
    "test:all": "npm run test:native && npm run test:es5",
    "test:native": "npm run test:full",
    "test:unit": "mocha --require spec/config/setup.js --require spec/config/setup-unit.js spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup.js spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup.js spec/end-to-end --recursive",
    "test:browser": "if [ ! -f .disable-test-browser ]; then npm run build && npm run test:jasmine; fi",
    "test:jasmine": "grunt jasmine",
    "test:unit:es5": "export EXCEL_BUILD=es5 && npm run test:unit",
    "test:integration:es5": "export EXCEL_BUILD=es5 && npm run test:integration",
    "test:end-to-end:es5": "export EXCEL_BUILD=es5 && npm run test:end-to-end",
    "test:dist": "mocha --require spec/config/setup.js spec/dist --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "tsc -p tsconfig.json && mocha --node-option import=tsx \"spec/typescript/**/*.spec.ts\"",
    "clean-build": "npm run clean && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build": "grunt build",
    "install-build": "npm install && grunt build",
    "preversion": "npm run clean && npm run build && npm run test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint"
    ],
    "!(*.js)": "prettier --write --ignore-unknown"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^8.0.0",
    "dayjs": "^1.11.23",
    "fast-csv": "^5.0.8",
    "jszip": "^3.10.2",
    "readable-stream": "^4.8.0",
    "saxes": "^6.0.0",
    "tmp": "^0.2.7",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "browserify": "^17.0.1",
    "chai": "^6.3.0",
    "chai-datetime": "^1.8.1",
    "chai-xml": "^0.4.1",
    "core-js": "^3.51.0",
    "dirty-chai": "^3.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-n": "^18.5.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "grunt": "^1.6.3",
    "grunt-babel": "^8.0.0",
    "grunt-browserify": "^6.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-jasmine": "^4.0.0",
    "grunt-contrib-watch": "^1.1.0",
    "grunt-terser": "^2.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "regenerator-runtime": "^0.14.1",
    "sax": "^1.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
