{
  "name": "exceljs",
  "version": "5.0.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "private": false,
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ultrafastwork/exceljs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.0",
  "type": "module",
  "main": "./lib/exceljs.nodejs.js",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "browser": {
        "import": "./dist/exceljs.browser.mjs",
        "default": "./dist/exceljs.min.js"
      },
      "default": "./lib/exceljs.nodejs.js"
    },
    "./browser": {
      "types": "./index.d.ts",
      "import": "./dist/exceljs.browser.mjs",
      "default": "./dist/exceljs.min.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "imports": {
    "#crypto": {
      "browser": "./lib/platform/crypto.browser.js",
      "default": "./lib/platform/crypto.node.js"
    }
  },
  "files": [
    "dist",
    "lib",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.d.ts"
  ],
  "scripts": {
    "test": "pnpm build && pnpm test:node && pnpm test:browser && pnpm test:typescript && pnpm test:dist",
    "test:node": "pnpm test:unit && pnpm test:integration && pnpm test:end-to-end",
    "test:unit": "mocha --require spec/config/setup.js spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup.js spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup.js spec/end-to-end --recursive",
    "test:browser": "node spec/browser/run.js",
    "test:dist": "mocha --require spec/config/setup.js spec/dist --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "tsc -p tsconfig.json && mocha --node-option import=tsx \"spec/typescript/**/*.spec.ts\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:staged": "lint-staged",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('build',{recursive:true,force:true})\"",
    "build": "node scripts/build.js",
    "benchmark": "node --expose-gc benchmark.js",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark.js",
    "preversion": "pnpm clean && pnpm test",
    "postversion": "git push --no-verify && git push --tags --no-verify",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint"
    ],
    "!(*.js)": "prettier --write --ignore-unknown"
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^8.0.0",
    "dayjs": "^1.11.23",
    "fast-csv": "^5.0.8",
    "jszip": "^3.10.2",
    "saxes": "^6.0.0",
    "tmp": "^0.2.7",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@noble/hashes": "^2.4.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "buffer": "^6.0.3",
    "chai": "^6.3.0",
    "chai-datetime": "^1.8.1",
    "chai-xml": "^0.4.1",
    "dirty-chai": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-n": "^18.5.0",
    "events": "^3.3.0",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "mocha": "^12.0.3",
    "prettier": "^3.10.1",
    "process": "^0.11.10",
    "puppeteer": "^25.18.1",
    "readable-stream": "^4.8.0",
    "sax": "^1.6.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
